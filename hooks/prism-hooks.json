{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/prism-activate.sh\" 2>/dev/null || exit 0",
            "timeout": 5,
            "statusMessage": "Loading prism reports..."
          }
        ]
      }
    ]
  }
}
